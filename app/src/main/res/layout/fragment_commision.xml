<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Date Selection Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Start Date -->
        <Button
            android:id="@+id/btnStartDate"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_margin="5dp"
            android:textSize="13sp"
            android:layout_height="wrap_content"
            android:text="Select Start Date" />

        <!-- End Date -->
        <Button
            android:id="@+id/btnEndDate"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:textSize="13dp"
            android:layout_margin="5dp"
            android:layout_height="wrap_content"
            android:text="Select End Date" />
    </LinearLayout>

    <!-- Buttons for Search and Clear -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="8dp">

        <!-- Search Button -->
        <Button
            android:id="@+id/btnSearch"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_margin="5dp"
            android:layout_height="wrap_content"
            android:text="Search" />

        <!-- Clear Button -->
        <Button
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_margin="5dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Clear" />
    </LinearLayout>

    <!-- RecyclerView for displaying results -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvLeftTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Left Total: 0"
            android:textStyle="bold"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/tvRightTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Right Total (Admin Commission): 0"
            android:textStyle="bold"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/tvPartnerTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Partner Total: 0"
            android:textStyle="bold"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/tvReverseMechanism"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reverse Mechanism charge not applicable."
            android:textStyle="italic"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"/>

    </LinearLayout>


</LinearLayout>
