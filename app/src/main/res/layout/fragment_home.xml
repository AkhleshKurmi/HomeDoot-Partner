<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".fragments.HomeFragment">
    <RelativeLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Toolbar/Header -->


        <!-- Job Availability Section -->
        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/rvJobAvailvility"/>

        <!-- Job Status -->
        <TextView
            android:id="@+id/noJobsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="No new jobs"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- More Jobs Section -->
        <TextView
            android:id="@+id/moreJobsText"
            android:layout_below="@id/noJobsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="1 more job today"
            android:textSize="16sp"
            android:textStyle="bold" />
        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/rvJobCard"/>


        <!-- Cult Section -->
        <TextView
            android:id="@+id/cultHeader"
            android:layout_below="@id/rvJobCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Cult"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/cultRecyclerView"
            android:layout_below="@id/cultHeader"
            android:layout_width="match_parent"
            android:layout_height="120dp" />

        <!-- Bottom Navigation -->


    </RelativeLayout>

</FrameLayout>